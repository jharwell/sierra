@startuml

!theme cerulean-outline

skinparam DefaultFontSize 14
skinparam defaultTextAlignment center
skinparam TitleFontSize 24
skinparam SequenceMessageAlignment center
skinparam DefaultFontColor #black
skinparam TitleFontColor #black
skinparam ParticipantFontColor #black
database ".csv file" as csv_source
entity "Thread pool" as thread_pool
entity "Format Converter" as converter
boundary "Multicore buffer" as stage1_out

title Offline Mode

csv_source --> thread_pool: Fetch raw\ndata (t0)
csv_source --> thread_pool: Fetch raw\ndata (t1)
csv_source --> thread_pool: Fetch raw\ndata (t...)
thread_pool -> converter : CSV row
converter -> stage1_out: Decode to\ninternal PDW

@enduml
