@startuml
!theme plain
!include sierra-palette.iuml
skinparam shadowing false
skinparam RoundCorner 10
skinparam linetype ortho
skinparam defaultTextAlignment center
hide empty description

'title SIERRA pipeline — each stage transforms inputs into outputs via swappable plugins

state "Key" as key {
  state "Input artifact"   as k_in   $ROLE_INPUT
  state "Output artifact"  as k_out  $ROLE_OUTPUT
  state "Active plugin"      as k_plug $ROLE_PLUGIN
  state "Active compute\nresource" as k_res  $ROLE_COMPUTE
  k_in -[hidden]r-> k_out
  k_out -[hidden]r-> k_plug
  k_plug -[hidden]r-> k_res
}

state "1. Generate inputs" as s1 {
  state "Expdef template\nXML, JSON, YAML,..." as in1 $ROLE_INPUT
  state "Experiment inputs\nXML, JSON, YAML,..." as out1 $ROLE_OUTPUT
  state "Engine\nExecution environment\nExpdef" as plug1 $ROLE_PLUGIN
  state "Host machine" as res1 $ROLE_COMPUTE
  in1 --> out1
  out1 -[hidden]d-> plug1
  plug1 -[hidden]d-> res1
}
state "2. Execute" as s2 {
  state "Experiment inputs\nXML, JSON, YAML" as in2 $ROLE_INPUT
  state "Raw outputs\nCSV, Arrow, GraphML,..." as out2 $ROLE_OUTPUT
  state "Engine\nExecution environment" as plug2 $ROLE_PLUGIN
  state "Host\nHPC\nReal robots" as res2 $ROLE_COMPUTE
  in2 --> out2
  out2 -[hidden]d-> plug2
  plug2 -[hidden]d-> res2
}
state "3. Process" as s3 {
  state "Raw outputs\n.csv, .arrow" as in3 $ROLE_INPUT
  state "Processed outputs\nCSV, Arrow, GraphML,..." as out3 $ROLE_OUTPUT
  state "Engine\nProcessors\nStorage" as plug3 $ROLE_PLUGIN
  state "Host machine" as res3 $ROLE_COMPUTE
  in3 --> out3
  out3 -[hidden]d-> plug3
  plug3 -[hidden]d-> res3
}
state "4. Generate products" as s4 {
  state "Processed outputs\nCSV, Arrow, GraphML" as in4 $ROLE_INPUT
  state "Products\ngraphs (PNG/HTML), video (mp4),..." as out4 $ROLE_OUTPUT
  state "Engine\nGenerators\nStorage" as plug4 $ROLE_PLUGIN
  state "Host machine" as res4 $ROLE_COMPUTE
  in4 --> out4
  out4 -[hidden]d-> plug4
  plug4 -[hidden]d-> res4
}
state "5. Compare products" as s5 {
  state "Products\ngraphs (PNG)" as in5 $ROLE_INPUT
  state "Comparisons\ngraphs (PNG),..." as out5 $ROLE_OUTPUT
  state "Engine\nComparators\nStorage" as plug5 $ROLE_PLUGIN
  state "Host machine" as res5 $ROLE_COMPUTE
  in5 --> out5
  out5 -[hidden]d-> plug5
  plug5 -[hidden]d-> res5
}

s1 -right-> s2
s2 -right-> s3
s3 -right-> s4
s4 -right-> s5
' key sits BELOW the pipeline (anchored off the stage container so it doesn't
' stretch any single column)
s3 -[hidden]d-> key
@enduml
