@startuml

!theme cerulean-outline

skinparam DefaultFontSize $FONT_BODY
skinparam defaultTextAlignment center
skinparam TitleFontSize $FONT_TITLE
skinparam SequenceMessageAlignment center
skinparam DefaultFontColor #black
skinparam TitleFontColor #black
skinparam ParticipantFontColor #black
database "ZMQ endpoint" as zmq_source
entity "Format Converter" as converter
boundary "Multicore buffer" as stage1_out

title Online Mode

zmq_source -> converter : Protobuf
converter -> stage1_out: Decode to\ninternal PDW

@enduml
