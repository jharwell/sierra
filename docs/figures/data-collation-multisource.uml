@startuml
!theme plain
!include sierra-palette.iuml
skinparam defaultTextAlignment center
skinparam DefaultFontSize $FONT_BODY
skinparam stateFontStyle bold
hide empty description

state "User\nSpecification" as user $USERSPEC

' Within each SCOPE, one target draws col0 from file0 AND colA from file1.
' The two contributing columns are colored; the others are de-emphasised to
' show only the named columns participate.
state "SCOPE 0" as SCOPE0 {
   state "file0" as file00 $FILEBOX {
      state "col0" as col000 $COL_0
      state "col1" as col001 $DEEMPHASIS
   }
   state "file1" as file01 $FILEBOX {
      state "colA" as col010 $COL_A
      state "colB" as col011 $DEEMPHASIS
   }
}
state "SCOPE 1" as SCOPE1 {
   state "file0" as file10 $FILEBOX {
      state "col0" as col100 $COL_0
      state "col1" as col101 $DEEMPHASIS
   }
   state "file1" as file11 $FILEBOX {
      state "colA" as col110 $COL_A
      state "colB" as col111 $DEEMPHASIS
   }
}
state "..." as SCOPEx $DEEMPHASIS
state "SCOPE j" as SCOPEj {
   state "file0" as filej0 $FILEBOX {
      state "col0" as colj00 $COL_0
      state "col1" as colj01 $DEEMPHASIS
   }
   state "file1" as filej1 $FILEBOX {
      state "colA" as colj10 $COL_A
      state "colB" as colj11 $DEEMPHASIS
   }
}

' Output: a SINGLE collated file whose columns are the joined
' (col0-from-file0, colA-from-file1) pair from every SCOPE.
state "Output: 'combined'" as inter $COMBINED {
   state "SCOPE 0" as colp0 {
      state "col0" as c00 $COL_0
      state "colA" as c01 $COL_A
   }
   state "SCOPE 1" as colp1 {
      state "col0" as c10 $COL_0
      state "colA" as c11 $COL_A
   }
   state "..." as colpx $DEEMPHASIS
   state "SCOPE j" as colpj {
      state "col0" as cj0 $COL_0
      state "colA" as cj1 $COL_A
   }
}

colp0 -[hidden]d-> colp1
colp1 -[hidden]d-> colpx
colpx -[hidden]d-> colpj

user --> SCOPE0
user --> SCOPE1
user --> SCOPEx
user --> SCOPEj
SCOPE0 --> inter
SCOPE1 --> inter
SCOPEx --> inter
SCOPEj --> inter
@enduml
